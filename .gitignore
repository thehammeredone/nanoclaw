# Dependencies
node_modules/
.npm-cache/
# pnpm content-addressable store (created when running in sandbox mode)
.pnpm-store/
# Build output
dist/

# Local data & auth
store/
data/
logs/

# Groups - per-installation state.
#
# LOCAL DIVERGENCE FROM UPSTREAM: upstream ignores groups/* wholesale and bans
# CLAUDE.local.md outright. This install tracks the per-group source of truth
# (CLAUDE.local.md, helper scripts, wiki/plans) so agent procedures live in a
# reviewable, revertible file instead of only inside frozen scheduled-task
# prompts. Never include these paths in an upstream PR.
#   CLAUDE.md    - composed at spawn by src/claude-md-compose.ts
#   container.json - inlines plaintext credentials, never commit
groups/*/CLAUDE.md
groups/*/container.json
groups/*/conversations/
groups/*/.claude/

# Radar's scraper: a shallow clone whose data/*.json churn on every run.
# The one local source change is vendored as groups/ai-news/ai-news-radar.patch.
groups/ai-news/ai-news-radar/
groups/ai-news/digest-*
# Article screenshots the digest run drops next to its output.
groups/ai-news/*.png

# Composer-managed artifacts (regenerated every spawn)
**/.claude-shared.md
**/.claude-fragments/

# Secrets
*.keys.json
.env
.env*
matrix-credentials.local.md

# Temp files
.tmp-*
*.swp

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Skills system (local per-installation state)
.nanoclaw/
.superpowers/
# written relative to cwd, so it can land in any directory
**/.claude/statusline.json

agents-sdk-docs
